{
  "name": "mohleyla",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "MohLeyla - learn Modern Standard Arabic, Saudi Arabic, English and Indonesian",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.mjs --strict",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "generate:audio": "node scripts/generate-audio.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check": "npm run validate:content && npm run validate:i18n && npm test && npm run build",
    "prebuild": "node scripts/build-manifest.mjs",
    "predev": "node scripts/build-manifest.mjs",
    "pretest": "node scripts/build-manifest.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@supabase/supabase-js": "^2.119.2",
    "i18next": "^23.16.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "sharp": "^0.33.5",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
