# The committed `.env.production` already holds the public production values, so hosts need no dashboard variables.
# Copy this file to .env.local to override them locally, or set variables in a host's dashboard (they take precedence).
# Both values are PUBLIC by design (shipped to the browser). Data is protected by row level security (supabase/schema.sql).
# NEVER put a service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
