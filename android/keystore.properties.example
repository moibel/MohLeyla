# Copy to android/keystore.properties (ignored by git) and fill in. Never commit the real file or the keystore.
# The same four values can instead come from the environment variables MOHLEYLA_KEYSTORE_FILE,
# MOHLEYLA_KEYSTORE_PASSWORD, MOHLEYLA_KEY_ALIAS and MOHLEYLA_KEY_PASSWORD.
# storeFile is an absolute path, or a path relative to the android/ folder.
storeFile=/absolute/path/to/your-upload-key.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
